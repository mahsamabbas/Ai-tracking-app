FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY scripts ./scripts
COPY infra/sql ./infra/sql
COPY infra/docker-entrypoint-api.sh ./infra/docker-entrypoint-api.sh

RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter @techlio/server-core build && pnpm --filter @techlio/api build

ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001

RUN chmod +x /app/infra/docker-entrypoint-api.sh
ENTRYPOINT ["/app/infra/docker-entrypoint-api.sh"]
